# Copy this file, rename the copy to ".env" (same folder as app.py) and fill in your values.
# Never share or upload the real .env file - it holds your passwords.

# Address used inside the QR codes and emails (your laptop's IP while testing, your website once deployed)
BASE_URL=http://192.168.29.167:5000
# Long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# The account with this email becomes the admin when it signs up
ADMIN_EMAIL=you@example.com

# ---------- Email alerts (Gmail example) ----------
# Gmail needs 2-Step Verification ON, then create an "App password" and paste it below
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---------- SMS alerts: choose ONE provider ----------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000
# Optional WhatsApp copy of every alert (Twilio WhatsApp sandbox or approved sender)
# WHATSAPP_FROM=whatsapp:+14155238886

# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=

# Minimum seconds between alerts for the same pet (0 = alert on every single scan)
SCAN_ALERT_COOLDOWN=60

# ---------- Vaccination reminders ----------
# Locally the app checks every few hours while it is running.
# On a host, call  https://YOUR-SITE/tasks/reminders?token=<CRON_TOKEN>  once a day from a free
# cron service (e.g. cron-job.org) and set a long random CRON_TOKEN here.
CRON_TOKEN=

# ---------- Deployment only ----------
# TRUST_PROXY=1            # when the host puts a proxy in front of the app (Render, Railway...)
# PETID_DATA_DIR=/var/data # a persistent disk, otherwise the database and photos are lost on redeploy
